# Konfigurasi Server
APP_HOST=127.0.0.1
APP_PORT=8000
APP_ENV=production

# Keamanan Sesi (Set SESSION_COOKIE_SECURE=true jika menggunakan reverse proxy HTTPS)
SESSION_COOKIE_NAME=catatan_session
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAMESITE=strict
SESSION_IDLE_TIMEOUT_MINUTES=30

# Rate Limiting Login
LOGIN_RATE_LIMIT_MAX_ATTEMPTS=5
LOGIN_RATE_LIMIT_LOCKOUT_MINUTES=15

# Penyimpanan dan File Upload
DATABASE_PATH=data/app.db
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=50
ALLOWED_EXTENSIONS=.doc,.docx,.xls,.xlsx,.csv,.txt,.log,.cfg,.conf,.ini,.json,.xml,.yml,.md,.pdf,.ppt,.pptx,.pkt,.pka,.zip,.png,.jpg
